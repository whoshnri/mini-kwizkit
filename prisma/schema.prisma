generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  male
  female
  other
}

enum Difficulty {
  easy
  medium
  hard
}

enum QuestionType {
  multiple_choice
  short_answer
  essay
  true_or_false
}

model User {
  id           String  @id @default(cuid())
  firstName    String?
  lastName     String?
  email        String? @unique
  username     String? @unique
  passwordHash String? @map("password_hash")
  uniqueId     String? @unique @map("unique_id")
  image        String?
  gender       Gender  @default(male)
  phone        String?
  city         String?
  accountId    String  @unique
  isActive     Boolean @default(true)

  tests           Test[]
  studentsCreated Student[]
  proctorFlags    LiveProctorFlag[]
  sessions        LoginSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model LoginSession {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_session")
}

model Student {
  id        String @id @default(cuid())
  firstName String
  lastName  String
  email     String @unique

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  testScores   TestScore[]
  liveAttempts LiveTestAttempt[]
  proctorFlags LiveProctorFlag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@map("students")
}

model Test {
  id                String     @id @default(cuid())
  name              String
  description       String?
  subjectName       String     @default("")
  totalMarks        Int?
  numberOfQuestions Int?
  difficulty        Difficulty @default(easy)
  slug              String     @unique
  settings          String     @default("{}")
  visibility        Boolean    @default(false)
  isScheduled       Boolean    @default(false)
  startTime         DateTime?
  duration          Int?
  allowRetake       Boolean    @default(false) @map("allow_retake")
  showResults       Boolean    @default(false) @map("show_results")

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  questions    Question[]
  testScores   TestScore[]
  liveAttempts LiveTestAttempt[]
  proctorFlags LiveProctorFlag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
}

model LiveTestAttempt {
  id                 String    @id @default(cuid())
  testId             String
  test               Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId          String
  student            Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  passwordUsed       Boolean   @default(false)
  setupCompleted     Boolean   @default(false)
  startedAt          DateTime  @default(now())
  examStartedAt      DateTime? @map("exam_started_at")
  submittedAt        DateTime?
  answers            String    @default("[]")
  flagged            String    @default("[]")
  score              Int?
  totalMarks         Int?
  violationFlags     Json      @default("[]") @map("violation_flags")
  proctorDeductions  Int       @default(0) @map("proctor_deductions")
  timePenaltySeconds Int       @default(0) @map("time_penalty_seconds")
  examCurrentIndex   Int       @default(0) @map("exam_current_index")
  endedByProctor     Boolean   @default(false) @map("ended_by_proctor")
  endReason          String?   @map("end_reason")
  proctorFlags       LiveProctorFlag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([testId])
  @@index([studentId])
  @@map("live_test_attempts")
}

model LiveProctorFlag {
  id        String           @id @default(cuid())
  testId    String
  test      Test             @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attemptId String?
  attempt   LiveTestAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  proctorId String
  proctor   User             @relation(fields: [proctorId], references: [id], onDelete: Cascade)
  note      String?

  createdAt DateTime @default(now())

  @@index([testId])
  @@index([studentId])
  @@index([proctorId])
  @@map("live_proctor_flags")
}

model Question {
  id            String       @id @default(cuid())
  text          String
  type          QuestionType
  options       String?
  correctOption Int?
  correctAnswer String?
  marks         Int
  explanation   String?
  order         Int          @default(0)

  testId String
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
}

model TestScore {
  id         String  @id @default(cuid())
  studentId  String
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  testId     String
  test       Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
  score      Int
  totalMarks Int
  passed     Boolean?
  remarks    String?
  gradedAt   DateTime?
  answers    String  @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, testId])
  @@index([studentId])
  @@index([testId])
  @@map("test_scores")
}
